# Copy to .env.local inside cms-pilot; never commit credentials.
# Sanity project ID is not a secret. Create a separate pilot project.
SANITY_STUDIO_PROJECT_ID=replace_with_project_id
SANITY_STUDIO_DATASET=pilot

# Do not place API tokens in SANITY_STUDIO_* variables.
# Private tokens (for a future server-side importer/build) belong in CI secrets.
