Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set Cache-Control "private, no-store, max-age=0"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # The only PHP entrypoint is index.php; no private PHP is copied here.
  RewriteRule ^(?!(?:index|consent)\.php$).*\.php$ - [F,L,NC]
  RewriteRule ^assets/ - [L]
  RewriteRule ^(?:index|consent)\.php$ - [L]
  RewriteRule ^$ index.php [L]
  RewriteRule . - [R=404,L]
</IfModule>

<FilesMatch "^(?:config\..*|.*\.(?:sql|bak|log|env|ini|json))$">
  Require all denied
</FilesMatch>
